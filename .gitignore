# SynTrends — closed-source posture
#
# Git tracks only what is required to build, test, CI, and deploy the stack.
# Everything else (runtime state, secrets, local ops, build output) stays local.
# Do not "hand over" .env, data/, keys, or operator configs — ever.

# --- Secrets & credentials (never commit) -----------------------------------
.env
.env.*
!.env.example
!**/.env.example
deploy/**/.env
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
credentials.json
secrets.json
secrets.*
*.secrets
.dev.vars
**/st_agent_*
**/st_thirdps_*
**/st_license_*
*st_agent_*
*st_thirdps_*

# --- Local operator / soak-test configs -------------------------------------
demo/overnight_agents.local.json
**/*agents.local.json
**/*.local.json
**/*.local.yaml
**/*.local.yml

# --- Runtime & persistence (live testnet / prod state) ----------------------
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
logs/
*.log
/tmp/
temp/
snapshot.json
**/snapshot.json
app_snapshot.json
*.snapshot.json
snapshots/

# --- Python build & cache ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
hypothesis/

# --- Test & tool caches -----------------------------------------------------
.pytest_cache/
.cache/

# --- Node / TypeScript SDK (build in CI; publish from clean build) ------------
node_modules/
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/typescript/dist-test/
sdk/typescript/*.tsbuildinfo

