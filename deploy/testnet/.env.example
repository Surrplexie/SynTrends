# Copy to deploy/testnet/.env before launching the public testnet.

POSTGRES_PASSWORD=change-me-testnet

SYNTRENDS_ENV=testnet
NETWORK_NAME=syntrends-testnet-1

CORS_ORIGINS=https://testnet.syntrends.com,https://owners.testnet.syntrends.com

FAUCET_ENABLED=1
FAUCET_AMOUNT=5000
FAUCET_COOLDOWN_SECONDS=3600

# Public beta: set KYC_PROVIDER=persona and fill Persona credentials below.
# Demo admin approve is OFF on testnet unless ALLOW_DEMO_KYC_APPROVE=1 (local only).
KYC_PROVIDER=persona
REQUIRE_REAL_KYC_ON_TESTNET=1
# ALLOW_DEMO_KYC_APPROVE=0

PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_TEMPLATE_ID=
PERSONA_ENVIRONMENT=sandbox

# Agent + 3rdPS read rate limits (per minute, in-process)
THIRDPS_RATE_LIMIT_PER_MINUTE=120
# Legacy alias for 3rdPS rate limit:
LICENSE_RATE_LIMIT_PER_MINUTE=120
AGENT_WRITE_RATE_LIMIT_PER_MINUTE=60

# Owner session TTL (seconds) — default 7 days
OWNER_SESSION_TTL_SECONDS=604800
