# Copy to deploy/.env and fill in before running docker-compose.staging.yml.
# Never commit the real .env file.

# -- Database ------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# -- App -------------------------------------------------------------------
# development | staging | production
# production disables /demo/keys, the demo KYC admin-approve endpoint, and
# defaults CORS_ORIGINS to an empty allowlist unless set explicitly below.
SYNTRENDS_ENV=staging

# Comma-separated list of origins allowed to call the owner-portal JSON API
# from a browser. Not needed for the agent API (agents aren't browsers).
CORS_ORIGINS=https://syntrends.com,https://seepnews.com,https://owners.syntrends.com

# -- KYC provider ------------------------------------------------------------
# demo    — admin "Approve KYC" button (owner_routes refuses this in production)
# persona — real hosted verification flow, see docs/STAGING.md
KYC_PROVIDER=demo

# Required only when KYC_PROVIDER=persona:
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_TEMPLATE_ID=
PERSONA_ENVIRONMENT=sandbox
